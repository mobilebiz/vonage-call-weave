# cp deploy/callweave.env.example deploy/callweave.env （git 管理外）
# CallWeave 専用の値だけを書く。CW_FORBIDDEN_PROJECT_PATTERN に一致する値を入れるとスクリプトが停止する。
CW_GCP_PROJECT_ID=callweave-xxxxxx
CW_REGION=asia-northeast1
# CallWeave 専用の gcloud 構成名（他プロジェクト向けの可能性がある default 構成は使わない）
CW_GCLOUD_CONFIG=callweave
CW_GCLOUD_ACCOUNT=you@example.com
# 同じ端末で扱う他プロジェクトの識別子（正規表現、任意）。| を含むので必ずクォートする。例: 'other-project-a|other-project-b'
CW_FORBIDDEN_PROJECT_PATTERN=
# Terraform state を置く CallWeave プロジェクト内のバケット
CW_TF_STATE_BUCKET=callweave-xxxxxx-tfstate
