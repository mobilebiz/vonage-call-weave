# ローカル開発用。cp env.local.example .env で作成（.env は git 管理外）。シェルの環境変数より優先される。
# CallWeave の設定は CW_ 接頭辞のみ。GOOGLE_CLOUD_PROJECT 等は参照しない。

CW_ENV=local
CW_SERVICE=all
CW_LOG_LEVEL=debug

# ローカルは GCP を使わない（メモリストア + プロセス内キュー）
CW_STORE=memory
CW_QUEUE=inline
# Firestore を使う場合のみ（CallWeave 専用プロジェクト。CW_FORBIDDEN_PROJECT_PATTERN に一致すると起動時に拒否）
# CW_STORE=firestore
# CW_GCP_PROJECT_ID=callweave-xxxxxx

# 実機 Vonage で試す場合は ngrok 等の公開 URL
CW_CONTROL_BASE_URL=http://localhost:8080
CW_MEDIA_WS_URL=ws://localhost:8080/media/vonage

# CallWeave 専用 Vonage アプリケーション
CW_VONAGE_APPLICATION_ID=
CW_VONAGE_PRIVATE_KEY_PATH=private.key
CW_VONAGE_SIGNATURE_SECRET=
CW_VONAGE_NUMBER=
CW_VONAGE_API_BASE=https://api.nexmo.com
CW_VERIFY_WEBHOOK_SIGNATURE=false

# Brekeke PBX
CW_SIP_TARGET_URI=
CW_SIP_FROM_MODE=caller

# 音声認識（CW_ASR_FAKE=1 なら全エンジンを擬似エンジンに置換）
CW_ASR_FAKE=1
CW_AMIVOICE_APPKEY=
CW_ELEVENLABS_API_KEY=
CW_DEEPGRAM_API_KEY=
